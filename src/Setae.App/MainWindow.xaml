<Window x:Class="Setae.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setae"
        Width="380"
        Height="245"
        MinWidth="320"
        MinHeight="215"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        SizeChanged="Window_OnSizeChanged"
        LocationChanged="Window_OnLocationChanged"
        IsVisibleChanged="Window_OnIsVisibleChanged"
        Closing="Window_OnClosing">
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Setae"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="21"
                       FontWeight="SemiBold" />
            <TextBlock Text="Monitor local del micrófono"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" x:Name="MeterArea" Height="36" Margin="0,0,0,4">
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6" />
            <Rectangle x:Name="LevelFill"
                       HorizontalAlignment="Left"
                       Fill="{DynamicResource NormalBrush}"
                       RadiusX="5"
                       RadiusY="5" />
            <Border x:Name="ThresholdMarker"
                    Width="2"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource TextBrush}"
                    ToolTip="Umbral" />
        </Grid>

        <Grid Grid.Row="2" Margin="1,0,1,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="0"
                       Foreground="{DynamicResource DimTextBrush}"
                       FontSize="11" />
            <TextBlock Grid.Column="1"
                       Text="100"
                       Foreground="{DynamicResource DimTextBrush}"
                       FontSize="11"
                       HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusBadge"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9,5">
                <TextBlock x:Name="StatusText"
                           Text="Detenido"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>
            <TextBlock x:Name="ThresholdText"
                       Grid.Column="1"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Text="Umbral 70" />
        </Grid>

        <TextBlock x:Name="NoticeText"
                   Grid.Row="4"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   MinHeight="30" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="SettingsButton"
                    Style="{StaticResource SecondaryButton}"
                    Content="Ajustes"
                    Margin="0,0,8,0"
                    Click="SettingsButton_OnClick" />
            <Button x:Name="StartStopButton"
                    Style="{StaticResource PrimaryButton}"
                    Content="Iniciar"
                    Click="StartStopButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
