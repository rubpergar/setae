<Application x:Class="Setae.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#171A1F" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#22262D" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2C323B" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#414956" />
        <SolidColorBrush x:Key="TextBrush" Color="#F1F4F8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB3C0" />
        <SolidColorBrush x:Key="NormalBrush" Color="#51D88A" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F2B84B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F06464" />
    </Application.Resources>
</Application>
