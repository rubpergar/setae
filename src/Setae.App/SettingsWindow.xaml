<Window x:Class="Setae.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes de Setae"
        Width="460"
        SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        ResizeMode="NoResize"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Padding" Value="7,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Padding" Value="7,4" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="7,4" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Micrófono de entrada"
                   FontWeight="SemiBold" />
        <DockPanel Grid.Row="1" Margin="0,0,0,14">
            <Button x:Name="RefreshButton"
                    DockPanel.Dock="Right"
                    Content="Refrescar"
                    Click="RefreshButton_OnClick" />
            <ComboBox x:Name="MicrophoneComboBox"
                      SelectedValuePath="Id"
                      ToolTip="Micrófono que se analizará" />
        </DockPanel>

        <TextBlock Grid.Row="2"
                   Text="Nivel captado ahora"
                   FontWeight="SemiBold" />
        <Grid Grid.Row="3" x:Name="PreviewMeterArea" Height="28" Margin="0,0,0,3">
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4" />
            <Rectangle x:Name="PreviewLevelFill"
                       HorizontalAlignment="Left"
                       Fill="{DynamicResource NormalBrush}"
                       RadiusX="3"
                       RadiusY="3" />
            <Border x:Name="PreviewThresholdMarker"
                    Width="2"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource TextBrush}"
                    ToolTip="Umbral" />
        </Grid>
        <Grid Grid.Row="4" Margin="1,0,1,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11" />
            <TextBlock Grid.Column="1"
                       Text="100"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"
                       HorizontalAlignment="Right" />
        </Grid>
        <TextBlock x:Name="PreviewStatusText"
                   Grid.Row="5"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Inicia la monitorización para ver el nivel en vivo."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="6" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Umbral de alerta (0-100)"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ThresholdValueText"
                       Grid.Column="1"
                       Text="70"
                       FontWeight="SemiBold" />
        </Grid>
        <Slider x:Name="ThresholdSlider"
                Grid.Row="7"
                Minimum="0"
                Maximum="100"
                TickFrequency="5"
                IsSnapToTickEnabled="False"
                ValueChanged="ThresholdSlider_OnValueChanged"
                Margin="0,0,0,16" />

        <Grid Grid.Row="8" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Duración mínima sobre umbral"
                       VerticalAlignment="Center" />
            <TextBox x:Name="DurationTextBox"
                     Grid.Column="1"
                     HorizontalContentAlignment="Right"
                     Margin="0,0,6,0" />
            <TextBlock Grid.Column="2"
                       Text="ms"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>

        <Grid Grid.Row="9" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Enfriamiento entre alertas"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CooldownTextBox"
                     Grid.Column="1"
                     HorizontalContentAlignment="Right"
                     Margin="0,0,6,0" />
            <TextBlock Grid.Column="2"
                       Text="s"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>

        <StackPanel Grid.Row="10" Margin="0,0,0,12">
            <CheckBox x:Name="BeepCheckBox"
                      Content="Reproducir pitido al alertar"
                      Foreground="{DynamicResource TextBrush}"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="TopmostCheckBox"
                      Content="Mantener la ventana siempre visible"
                      Foreground="{DynamicResource TextBrush}" />
        </StackPanel>

        <Grid Grid.Row="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Restaurar valores iniciales"
                        Click="RestoreDefaultsButton_OnClick" />
                <Button Content="Cancelar"
                        Click="CancelButton_OnClick" />
                <Button Content="Guardar"
                        Click="SaveButton_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
