<Window x:Class="Setae.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes de Setae"
        Width="460"
        SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        ResizeMode="NoResize"
        UseLayoutRounding="True">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource SectionLabel}"
                   Text="Micrófono de entrada"
                   />
        <DockPanel Grid.Row="1" Margin="0,0,0,14">
            <Button x:Name="RefreshButton"
                    Style="{StaticResource SecondaryButton}"
                    DockPanel.Dock="Right"
                    Content="Refrescar"
                    Margin="10,0,0,0"
                    Click="RefreshButton_OnClick" />
            <ComboBox x:Name="MicrophoneComboBox"
                      Style="{StaticResource DarkComboBox}"
                      SelectedValuePath="Id"
                      ToolTip="Micrófono que se analizará" />
        </DockPanel>

        <TextBlock Grid.Row="2"
                   Style="{StaticResource SectionLabel}"
                   Text="Nivel captado ahora"
                   />
        <Grid Grid.Row="3" x:Name="PreviewMeterArea" Height="28" Margin="0,0,0,3">
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4" />
            <Rectangle x:Name="PreviewLevelFill"
                       HorizontalAlignment="Left"
                       Fill="{DynamicResource NormalBrush}"
                       RadiusX="3"
                       RadiusY="3" />
            <Border x:Name="PreviewThresholdMarker"
                    Width="2"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource TextBrush}"
                    ToolTip="Umbral" />
        </Grid>
        <Grid Grid.Row="4" Margin="1,0,1,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11" />
            <TextBlock Grid.Column="1"
                       Text="100"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"
                       HorizontalAlignment="Right" />
        </Grid>
        <TextBlock x:Name="PreviewStatusText"
                   Grid.Row="5"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Inicia la monitorización para ver el nivel en vivo."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="6" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Umbral de alerta (0-100)"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ThresholdValueText"
                       Grid.Column="1"
                       Text="70"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" />
        </Grid>
        <Slider x:Name="ThresholdSlider"
                Grid.Row="7"
                Minimum="0"
                Maximum="100"
                TickFrequency="5"
                IsSnapToTickEnabled="False"
                ValueChanged="ThresholdSlider_OnValueChanged"
                Margin="0,0,0,16" />

        <Grid Grid.Row="8" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Duración mínima sobre umbral"
                       VerticalAlignment="Center" />
            <TextBox x:Name="DurationTextBox"
                     Style="{StaticResource DarkTextBox}"
                     Grid.Column="1"
                     HorizontalContentAlignment="Right"
                     Margin="0,0,6,0" />
            <TextBlock Grid.Column="2"
                       Text="ms"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>

        <Grid Grid.Row="9" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Enfriamiento entre alertas"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CooldownTextBox"
                     Style="{StaticResource DarkTextBox}"
                     Grid.Column="1"
                     HorizontalContentAlignment="Right"
                     Margin="0,0,6,0" />
            <TextBlock Grid.Column="2"
                       Text="s"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>

        <StackPanel Grid.Row="10" Margin="0,0,0,12">
            <CheckBox x:Name="BeepCheckBox"
                      Style="{StaticResource DarkCheckBox}"
                      Content="Reproducir pitido al alertar"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="TopmostCheckBox"
                      Style="{StaticResource DarkCheckBox}"
                      Content="Mantener la ventana siempre visible" />
        </StackPanel>

        <Grid Grid.Row="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Restaurar valores iniciales"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="RestoreDefaultsButton_OnClick" />
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="CancelButton_OnClick" />
                <Button Content="Guardar"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0"
                        Click="SaveButton_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
